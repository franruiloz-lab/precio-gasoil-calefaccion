---
import { formatPrice } from '../utils/format';

interface PriceRow {
  nombre: string;
  slug?: string;
  precioMin: number;
  precioMedio: number;
  precioMax: number;
  linkable?: boolean;
}

interface Props {
  rows: PriceRow[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<table class="price-table">
  {caption && <caption style="text-align:left;padding:0.75rem 1rem;font-weight:600;">{caption}</caption>}
  <thead>
    <tr>
      <th scope="col">Regi&oacute;n</th>
      <th scope="col">M&iacute;nimo</th>
      <th scope="col">Precio Medio</th>
      <th scope="col">M&aacute;ximo</th>
    </tr>
  </thead>
  <tbody>
    {rows.map(row => (
      <tr>
        <td>
          {row.linkable !== false && row.slug ? (
            <a href={`/precio-gasoil-calefaccion/${row.slug}/`}>
              <strong>{row.nombre}</strong>
            </a>
          ) : (
            <strong>{row.nombre}</strong>
          )}
        </td>
        <td class="price price-low">{formatPrice(row.precioMin)} &euro;</td>
        <td class="price">{formatPrice(row.precioMedio)} &euro;</td>
        <td class="price price-high">{formatPrice(row.precioMax)} &euro;</td>
      </tr>
    ))}
  </tbody>
</table>
