const categoryConfig: Record<string, { icon: string; cssClass: string }> = {
  'Guías': { icon: '\ud83d\udcd6', cssClass: 'guias' },
  'Comparativas': { icon: '\u2696\ufe0f', cssClass: 'comparativas' },
  'Ahorro': { icon: '\ud83d\udcb0', cssClass: 'ahorro' },
  'Normativa': { icon: '\ud83d\udccb', cssClass: 'normativa' },
};

const categories = [...new Set(articles.map(a => a.category))];
---

<BaseLayout
  title="Blog sobre Gasoil de Calefacción - Guías, Consejos y Comparativas"
  description="Artículos y guías sobre gasoil de calefacción: comparativas, consejos de ahorro, mantenimiento de calderas, normativa y subvenciones."
>
  <SchemaBreadcrumb
    slot="schema"
    items={[
      { name: 'Inicio', url: '/' },
      { name: 'Blog', url: '/blog/' }
    ]}
  />

  <Header />

  <main class="container">
    <nav class="breadcrumbs">
      <a href="/">Inicio</a> &raquo;
      <span>Blog</span>
    </nav>

    <div class="blog-hero">
      <h1>Gu&iacute;as y Consejos sobre Gasoil de Calefacci&oacute;n</h1>
      <p>
        Todo lo que necesitas saber sobre gas&oacute;leo C: comparativas con otras energ&iacute;as,
        consejos de ahorro, mantenimiento de calderas, normativa y subvenciones.
      </p>
    </div>

    {categories.map(cat => {
      const cfg = categoryConfig[cat];
      return (
        <section>
          <div class="blog-section-title">
            <div class={`blog-section-icon blog-section-icon--${cfg.cssClass}`}>{cfg.icon}</div>
            <h2 style="margin:0;">{cat}</h2>
          </div>
          <div class="blog-grid">
            {articles.filter(a => a.category === cat).map(article => {
              const acfg = categoryConfig[article.category];
              return (
                <a href={`/blog/${article.slug}/`} class={`blog-card blog-card--${acfg.cssClass}`}>
                  <div class={`blog-category-label blog-category-label--${acfg.cssClass}`}>{article.category}</div>
                  <h3>{article.title}</h3>
                  <p>{article.description}</p>
                  <span class="blog-card-arrow">Leer art&iacute;culo &rarr;</span>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

    <section style="margin-top:3rem;">
      <div class="blog-section-title">
        <div class="blog-section-icon" style="background:linear-gradient(135deg,#eff6ff,#f0fdf4);">&#128295;</div>
        <h2 style="margin:0;">Herramientas</h2>
      </div>
      <div class="tools-grid">
        <a href="/" class="tool-card">
          <div class="tool-card-icon">&euro;</div>
          <h3>Precio del Gasoil Hoy</h3>
          <p>Precio actualizado por CCAA y provincia</p>
        </a>
        <a href="/calculadora/" class="tool-card">
          <div class="tool-card-icon">&sum;</div>
          <h3>Calculadora de Coste</h3>
          <p>Calcula cu&aacute;nto te costar&aacute; tu pedido</p>
        </a>
        <a href="/evolucion-precio/" class="tool-card">
          <div class="tool-card-icon">&nearr;</div>
          <h3>Evoluci&oacute;n del Precio</h3>
          <p>Gr&aacute;fico de los &uacute;ltimos 24 meses</p>
        </a>
        <a href="/consumo-caldera-gasoil/" class="tool-card">
          <div class="tool-card-icon">&there4;</div>
          <h3>Consumo de Caldera</h3>
          <p>Calcula el gasto seg&uacute;n tu vivienda</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
