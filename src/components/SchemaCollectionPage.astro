---
interface Item {
  name: string;
  url: string;
  description?: string;
}

interface Props {
  name: string;
  description: string;
  url: string;
  items: Item[];
}

const { name, description, url, items } = Astro.props;
const siteUrl = 'https://calienteybarato.com';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": name,
  "description": description,
  "url": `${siteUrl}${url}`,
  "inLanguage": "es-ES",
  "hasPart": items.map(item => ({
    "@type": "WebPage",
    "name": item.name,
    "url": `${siteUrl}${item.url}`,
    ...(item.description ? { "description": item.description } : {})
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
