---
import regiones from '../data/regiones.json';
import precios from '../data/precios.json';

interface Props {
  selectedRegion?: string;
}

const { selectedRegion } = Astro.props;

const preciosData = JSON.stringify({
  nacional: precios.nacional.precioMedio,
  regiones: Object.fromEntries(
    Object.entries(precios.regiones).map(([k, v]) => [k, (v as any).precioMedio])
  )
});
---

<div class="calculator" id="calculadora-gasoil">
  <div class="form-group">
    <label for="calc-region">Comunidad Aut&oacute;noma</label>
    <select id="calc-region">
      <option value="nacional" selected={!selectedRegion}>Media nacional</option>
      {regiones.map(r => (
        <option value={r.id} selected={r.slug === selectedRegion}>
          {r.nombre}
        </option>
      ))}
    </select>
  </div>

  <div class="form-group">
    <label>Cantidad r&aacute;pida</label>
    <div class="quick-buttons" role="group" aria-label="Seleccionar cantidad rápida">
      <button class="quick-btn" data-liters="500" type="button" aria-pressed="false">500 L</button>
      <button class="quick-btn active" data-liters="1000" type="button" aria-pressed="true">1.000 L</button>
      <button class="quick-btn" data-liters="1500" type="button" aria-pressed="false">1.500 L</button>
      <button class="quick-btn" data-liters="2000" type="button" aria-pressed="false">2.000 L</button>
    </div>
  </div>

  <div class="form-group">
    <label for="calc-liters">O introduce los litros manualmente</label>
    <input type="number" id="calc-liters" inputmode="numeric" min="100" max="10000" step="50" value="1000" />
  </div>

  <div class="result">
    <div>Coste estimado</div>
    <div class="result-price" id="calc-result">1.059,00 &euro;</div>
    <div style="font-size:0.85rem;color:var(--color-text-secondary);margin-top:0.25rem;">
      al precio medio de <span id="calc-price-display">1,059</span> &euro;/litro
    </div>
  </div>
</div>

<script define:vars={{ preciosData }}>
  const data = JSON.parse(preciosData);

  function calculate() {
    const region = document.getElementById('calc-region').value;
    const liters = parseFloat(document.getElementById('calc-liters').value) || 0;
    const price = region === 'nacional' ? data.nacional : (data.regiones[region] || data.nacional);
    const totalNum = liters * price;
    const total = totalNum.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const priceDisplay = price.toFixed(3).replace('.', ',');

    document.getElementById('calc-result').textContent = total + ' \u20ac';
    document.getElementById('calc-price-display').textContent = priceDisplay;
  }

  document.getElementById('calc-region').addEventListener('change', calculate);
  document.getElementById('calc-liters').addEventListener('input', calculate);

  document.querySelectorAll('.quick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.quick-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      document.getElementById('calc-liters').value = btn.dataset.liters;
      calculate();
    });
  });

  calculate();
</script>
