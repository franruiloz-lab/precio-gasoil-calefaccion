---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SchemaBreadcrumb from '../../components/SchemaBreadcrumb.astro';
import SchemaArticle from '../../components/SchemaArticle.astro';
import PriceHero from '../../components/PriceHero.astro';
import PriceTable from '../../components/PriceTable.astro';
import RegionGrid from '../../components/RegionGrid.astro';
import PriceCalculator from '../../components/PriceCalculator.astro';
import PriceChart from '../../components/PriceChart.astro';
import FAQ from '../../components/FAQ.astro';

import regiones from '../../data/regiones.json';
import precios from '../../data/precios.json';
import provincias from '../../data/provincias.json';
import preciosProvincias from '../../data/precios-provincias.json';
import { formatPrice, getCurrentMonthYear, calculateCost } from '../../utils/format';

export function getStaticPaths() {
  return regiones.map(r => ({
    params: { region: r.slug },
    props: { regionData: r }
  }));
}

const { regionData } = Astro.props;
const monthYear = getCurrentMonthYear();
const siteUrl = 'https://calienteybarato.com';
const regionPrecios = precios.regiones[regionData.id as keyof typeof precios.regiones];
const nacionalPrecios = precios.nacional;

const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  { name: `Gasoil Calefacción en ${regionData.nombre}` }
];

// Build province rows with real data and links
const ccaaProvincias = provincias.filter((p: any) => p.ccaaSlug === regionData.slug);
const provinciaRows = ccaaProvincias.map((prov: any) => {
  const provPrecios = (preciosProvincias.provincias as any)[prov.slug];
  return {
    nombre: prov.nombre,
    slug: `provincia/${prov.slug}`,
    precioMin: provPrecios?.precioMin || regionPrecios.precioMin,
    precioMedio: provPrecios?.precioMedio || regionPrecios.precioMedio,
    precioMax: provPrecios?.precioMax || regionPrecios.precioMax,
    linkable: true
  };
});

// FAQ con datos reales inyectados
const faqItems = regionData.faq.map((f: { pregunta: string; respuesta: string }) => ({
  pregunta: f.pregunta,
  respuesta: f.respuesta
    .replace(/{precioMedio}/g, formatPrice(regionPrecios.precioMedio))
    .replace(/{lastUpdated}/g, precios.lastUpdated)
    .replace(/{precio1000}/g, calculateCost(1000, regionPrecios.precioMedio))
}));

const pageTitle = `Precio Gasoil Calefacción en ${regionData.nombre} Hoy [${formatPrice(regionPrecios.precioMedio)} €/L] - ${monthYear}`;
const pageDesc = `Precio del gasoil de calefacción en ${regionData.nombre} hoy: ${formatPrice(regionPrecios.precioMedio)} €/litro. Precios por provincia, calculadora de coste y evolución. Actualizado ${precios.lastUpdated}.`;

const diffVsNacional = regionPrecios.precioMedio - nacionalPrecios.precioMedio;
const diffText = diffVsNacional < 0
  ? `${Math.abs(diffVsNacional * 100).toFixed(1).replace('.', ',')} céntimos por debajo`
  : diffVsNacional > 0
  ? `${(diffVsNacional * 100).toFixed(1).replace('.', ',')} céntimos por encima`
  : 'igual';
---

<BaseLayout title={pageTitle} description={pageDesc} type="article">
  <Fragment slot="schema">
    <SchemaBreadcrumb items={breadcrumbItems} />
    <SchemaArticle
      title={pageTitle}
      description={pageDesc}
      url={`${siteUrl}/precio-gasoil-calefaccion/${regionData.slug}/`}
      dateModified={precios.lastUpdated}
    />
  </Fragment>

  <Header />

  <main class="container">
    <Breadcrumbs items={breadcrumbItems} />

    <PriceHero
      precio={regionPrecios.precioMedio}
      variacionMensual={regionPrecios.variacionMensual}
      lastUpdated={precios.lastUpdated}
      regionName={regionData.nombre}
    />

    <!-- Comparativa con la media nacional -->
    <section id="comparativa">
      <h2>Precio del Gasoil de Calefacción en {regionData.nombre} vs Media Nacional</h2>
      <p>
        El precio medio del gasoil de calefacción en <strong>{regionData.nombre}</strong> es de
        <strong>{formatPrice(regionPrecios.precioMedio)} €/litro</strong>, lo que se sitúa
        <strong>{diffText}</strong> de la media nacional de {formatPrice(nacionalPrecios.precioMedio)} €/litro.
      </p>
      <table class="price-table">
        <thead>
          <tr>
            <th></th>
            <th>Mínimo</th>
            <th>Precio Medio</th>
            <th>Máximo</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>{regionData.nombre}</strong></td>
            <td class="price price-low">{formatPrice(regionPrecios.precioMin)} €</td>
            <td class="price">{formatPrice(regionPrecios.precioMedio)} €</td>
            <td class="price price-high">{formatPrice(regionPrecios.precioMax)} €</td>
          </tr>
          <tr>
            <td><strong>Media Nacional</strong></td>
            <td class="price price-low">{formatPrice(nacionalPrecios.precioMin)} €</td>
            <td class="price">{formatPrice(nacionalPrecios.precioMedio)} €</td>
            <td class="price price-high">{formatPrice(nacionalPrecios.precioMax)} €</td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- Precios por provincia -->
    {provinciaRows.length > 1 && (
      <section id="provincias">
        <h2>Precio del Gasoil de Calefacci&oacute;n por Provincia en {regionData.nombre}</h2>
        <p>
          Precio del gasoil de calefacci&oacute;n en cada provincia de {regionData.nombre}.
          Haz clic en cualquier provincia para ver m&aacute;s detalles, comparativas y consejos espec&iacute;ficos.
        </p>
        <PriceTable rows={provinciaRows} />
      </section>
    )}
    {provinciaRows.length === 1 && (
      <section id="provincias">
        <h2>Precio del Gasoil de Calefacci&oacute;n en {provinciaRows[0].nombre}</h2>
        <p>
          <a href={`/precio-gasoil-calefaccion/provincia/${ccaaProvincias[0].slug}/`}>
            Ver detalles del precio del gasoil en {provinciaRows[0].nombre}
          </a>.
        </p>
      </section>
    )}

    <!-- Calculadora -->
    <section id="calculadora">
      <h2>Calculadora de Gasoil de Calefacción en {regionData.nombre}</h2>
      <p>
        Calcula cuánto te costará llenar tu depósito de gasoil de calefacción en {regionData.nombre}.
        Al precio medio actual, 1.000 litros cuestan aproximadamente <strong>{calculateCost(1000, regionPrecios.precioMedio)} €</strong>.
      </p>
      <PriceCalculator selectedRegion={regionData.slug} />
    </section>

    <!-- Gráfico de evolución -->
    <section id="evolucion">
      <h2>Evolución del Precio del Gasoil de Calefacción en {regionData.nombre}</h2>
      <p>
        Evolución del precio del gasoil de calefacción en {regionData.nombre} comparado con la media nacional
        durante los últimos 24 meses.
      </p>
      <PriceChart regionId={regionData.id} regionName={regionData.nombre} />
    </section>

    <!-- FAQ -->
    <section id="preguntas-frecuentes">
      <h2>Preguntas Frecuentes sobre el Gasoil de Calefacción en {regionData.nombre}</h2>
      <FAQ items={faqItems} />
    </section>

    <!-- Contenido unico regional -->
    <section id="informacion">
      <h2>Informaci&oacute;n sobre el Gasoil de Calefacci&oacute;n en {regionData.nombre}</h2>
      <div class="content">
        <p>{regionData.descripcion}</p>
        <p>
          En {regionData.nombre} el gasoil de calefacci&oacute;n (<a href="/blog/diferencia-gasoleo-a-b-c/">gas&oacute;leo C</a>) es distribuido por m&uacute;ltiples proveedores
          que realizan entregas a domicilio mediante camiones cisterna. El pedido m&iacute;nimo suele ser de 400-500 litros
          y el precio por litro disminuye a medida que aumenta la cantidad solicitada.
        </p>

        <h3>&iquest;Cu&aacute;nto cuesta el gasoil de calefacci&oacute;n en {regionData.nombre}?</h3>
        <ul>
          <li><strong>500 litros</strong>: {calculateCost(500, regionPrecios.precioMedio)} &euro;</li>
          <li><strong>1.000 litros</strong>: {calculateCost(1000, regionPrecios.precioMedio)} &euro;</li>
          <li><strong>1.500 litros</strong>: {calculateCost(1500, regionPrecios.precioMedio)} &euro;</li>
          <li><strong>2.000 litros</strong>: {calculateCost(2000, regionPrecios.precioMedio)} &euro;</li>
        </ul>

        <h3>Consejos para ahorrar en {regionData.nombre}</h3>
        <ul>
          <li><a href="/blog/cuando-es-mas-barato-gasoil-calefaccion/">Compra en verano</a> cuando los precios son m&aacute;s bajos.</li>
          <li>Pide mayor cantidad para reducir el precio por litro.</li>
          <li>Compara al menos 3 distribuidores de la zona.</li>
          <li>Considera la <a href="/blog/gasoil-calefaccion-comunidad-vecinos/">compra agrupada</a> con vecinos.</li>
          <li>Revisa el <a href="/blog/mantenimiento-caldera-gasoil/">mantenimiento de tu caldera</a> para optimizar el consumo.</li>
        </ul>
        <p>
          Consulta tambi&eacute;n <a href="/blog/como-ahorrar-gasoil-calefaccion/">15 consejos para ahorrar</a>
          o compara el gasoil con alternativas como el <a href="/blog/gasoil-calefaccion-vs-gas-natural/">gas natural</a>
          o la <a href="/blog/gasoil-calefaccion-vs-aerotermia/">aerotermia</a>.
        </p>
      </div>
    </section>

    <!-- Otras CCAA -->
    <section id="otras-comunidades">
      <h2>Precio del Gasoil de Calefacción en Otras Comunidades</h2>
      <RegionGrid excludeSlug={regionData.slug} />
    </section>
  </main>

  <Footer />
</BaseLayout>
