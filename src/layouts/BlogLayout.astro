---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaBreadcrumb from '../components/SchemaBreadcrumb.astro';
import SchemaArticle from '../components/SchemaArticle.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: 'Guías' | 'Comparativas' | 'Ahorro' | 'Normativa';
  breadcrumbName: string;
  datePublished?: string;
  dateModified?: string;
}

const { title, description, slug, category, breadcrumbName, datePublished = '2026-02-01', dateModified = '2026-02-20' } = Astro.props;

const categoryConfig: Record<string, { cssClass: string; icon: string }> = {
  'Guías': { cssClass: 'guias', icon: '\ud83d\udcd6' },
  'Comparativas': { cssClass: 'comparativas', icon: '\u2696\ufe0f' },
  'Ahorro': { cssClass: 'ahorro', icon: '\ud83d\udcb0' },
  'Normativa': { cssClass: 'normativa', icon: '\ud83d\udccb' },
};

const cfg = categoryConfig[category];
const siteUrl = 'https://calienteybarato.com';
const fullUrl = `${siteUrl}/blog/${slug}/`;

const allArticles = [
  { slug: 'diferencia-gasoleo-a-b-c', title: 'Diferencia entre Gasóleo A, B y C', category: 'Guías' },
  { slug: 'consumo-caldera-gasoil', title: 'Consumo de Caldera de Gasoil', category: 'Guías' },
  { slug: 'mantenimiento-caldera-gasoil', title: 'Mantenimiento de Caldera', category: 'Guías' },
  { slug: 'como-purgar-caldera-gasoil', title: 'Cómo Purgar la Caldera', category: 'Guías' },
  { slug: 'caldera-gasoil-condensacion', title: 'Caldera de Condensación', category: 'Guías' },
  { slug: 'averia-caldera-gasoil', title: 'Averías de la Caldera', category: 'Guías' },
  { slug: 'caldera-gasoil-no-enciende', title: 'Caldera no Enciende', category: 'Guías' },
  { slug: 'cuanto-gasoil-necesito-al-ano', title: '¿Cuánto Gasoil Necesito al Año?', category: 'Guías' },
  { slug: 'tipos-deposito-gasoil-calefaccion', title: 'Tipos de Depósito de Gasoil', category: 'Guías' },
  { slug: 'limpiar-deposito-gasoil', title: 'Limpiar el Depósito de Gasoil', category: 'Guías' },
  { slug: 'gasoil-calefaccion-comunidad-vecinos', title: 'Calefacción en Comunidades', category: 'Guías' },
  { slug: 'gasoil-calefaccion-segunda-residencia', title: 'Gasoil en Segunda Residencia', category: 'Guías' },
  { slug: 'gasoil-calefaccion-zona-rural', title: 'Gasoil en Zonas Rurales', category: 'Guías' },
  { slug: 'precio-gasoil-calefaccion-europa', title: 'Precio del Gasoil en Europa', category: 'Guías' },
  { slug: 'evolucion-historica-precio-gasoil', title: 'Evolución Histórica del Precio', category: 'Guías' },
  { slug: 'gasoil-calefaccion-vs-gas-natural', title: 'Gasoil vs Gas Natural', category: 'Comparativas' },
  { slug: 'gasoil-calefaccion-vs-aerotermia', title: 'Gasoil vs Aerotermia', category: 'Comparativas' },
  { slug: 'gasoil-calefaccion-vs-pellets', title: 'Gasoil vs Pellets', category: 'Comparativas' },
  { slug: 'gasoil-calefaccion-vs-bomba-de-calor', title: 'Gasoil vs Bomba de Calor', category: 'Comparativas' },
  { slug: 'gasoil-calefaccion-vs-lena', title: 'Gasoil vs Leña', category: 'Comparativas' },
  { slug: 'cuando-es-mas-barato-gasoil-calefaccion', title: '¿Cuándo es Más Barato?', category: 'Ahorro' },
  { slug: 'como-ahorrar-gasoil-calefaccion', title: '15 Consejos para Ahorrar', category: 'Ahorro' },
  { slug: 'subvenciones-cambiar-caldera-gasoil', title: 'Subvenciones 2026', category: 'Ahorro' },
  { slug: 'como-pedir-gasoil-calefaccion', title: 'Cómo Pedir Gasoil', category: 'Ahorro' },
  { slug: 'grupo-compra-gasoil-calefaccion', title: 'Grupos de Compra de Gasoil', category: 'Ahorro' },
  { slug: 'normativa-deposito-gasoil', title: 'Normativa de Depósitos', category: 'Normativa' },
  { slug: 'iva-impuestos-gasoil-calefaccion', title: 'IVA e Impuestos', category: 'Normativa' },
  { slug: 'instalar-deposito-gasoil', title: 'Instalar un Depósito de Gasoil', category: 'Normativa' },
];

const related = allArticles.filter(a => a.slug !== slug).slice(0, 4);
---

<BaseLayout title={title} description={description} type="article">
  <SchemaArticle
    slot="schema"
    title={title}
    description={description}
    url={fullUrl}
    datePublished={datePublished}
    dateModified={dateModified}
  />
  <SchemaBreadcrumb
    slot="schema"
    items={[
      { name: 'Inicio', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: breadcrumbName, url: `/blog/${slug}/` }
    ]}
  />

  <Header />

  <main class="container">
    <nav class="breadcrumbs">
      <a href="/">Inicio</a> &raquo;
      <a href="/blog/">Blog</a> &raquo;
      <span>{breadcrumbName}</span>
    </nav>

    <div class="article-header">
      <div class="article-meta">
        <span class={`article-badge article-badge--${cfg.cssClass}`}>{cfg.icon} {category}</span>
        <span>Actualizado: {dateModified}</span>
      </div>
      <slot name="title" />
    </div>

    <article class="content">
      <slot />
    </article>

    <section class="blog-related">
      <h2>Art&iacute;culos Relacionados</h2>
      <div class="blog-grid">
        {related.map(a => {
          const acfg = categoryConfig[a.category];
          return (
            <a href={`/blog/${a.slug}/`} class={`blog-card blog-card--${acfg.cssClass}`}>
              <div class={`blog-category-label blog-category-label--${acfg.cssClass}`}>{a.category}</div>
              <h3>{a.title}</h3>
              <span class="blog-card-arrow">Leer art&iacute;culo &rarr;</span>
            </a>
          );
        })}
      </div>
      <p style="text-align:center;margin-top:1.5rem;">
        <a href="/blog/" style="font-weight:600;">Ver todos los art&iacute;culos &rarr;</a>
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
